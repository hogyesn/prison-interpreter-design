START:
	COMMANDS
;

COMMANDS:
	COMMAND | COMMANDS COMMAND
;

COMMAND:
	EXPRESSION | BRANCH | ASSIGN | DECLARE
;

EXPRESSION:
	ADD | NUMBER | ID
;

EXPRESSIONS:
	EXPRESSION | EXPRESSIONS EXPRESSION
;

NUMBER:
	INT | FLOAT
;

TYPE:
	'int' | 'float'
;


DECLARE:
	TYPE ID {
		declare $1 $2
	}
	|
	TYPE ID '=' EXPRESSION {
		declare $1 $2 $4
	}
;


ASSIGN:
	ID '=' EXPRESSION {
		assign $1 $3
	}
;

ADD:
	EXPRESSION '+' EXPRESSION {
		add $1 $3
	}
;

BRANCH:
	'if' '(' EXPRESSION ')' '{' EXPRESSIONS '}' {
		if $3 $6
	}
;


INT:
	[0-9]+ {
		int $1
	}
;

FLOAT:
	([0-9]+([.][0-9]*)?|[.][0-9]+) {
		float $1
	}
;

ID:
	[a-zA-Z][a-zA-Z_0-9]* {
		id $1
	}
;
